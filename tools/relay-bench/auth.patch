+/// Per-connection NIP-42 state.
+#[derive(Default)]
+struct Peer {
+    authed: Option<String>,
+    challenged: bool,
+}
+
+/// The mailbox a gift-wrap filter reads (`kinds:[1059]` with a `#p`), as hex.
+fn private_mailbox(filters: &str) -> Option<&str> {
+    if !filters.contains("\"kinds\":[1059]") {
+        return None;
+    }
+    let at = filters.find("\"#p\":[\"")? + 7;
+    filters.get(at..at + 64)
+}
+
+/// Under the NIP-17 faults, refuses a mailbox read from anyone but its recipient.
+fn gate(filters: &str, sub: &str, fault: Fault, peer: &mut Peer, out: &mut Vec<u8>) -> bool {
+    if !matches!(fault, Fault::Nip17 | Fault::Nip17Lazy) {
+        return false;
+    }
+    let Some(p) = private_mailbox(filters) else { return false };
+    if peer.authed.as_deref() == Some(p) {
+        return false;
+    }
+    if !peer.challenged {
+        send(out, &format!("[\"AUTH\",\"{CHALLENGE}\"]"));
+        peer.challenged = true;
+    }
+    send(out, &format!("[\"CLOSED\",\"{sub}\",\"auth-required: gift wraps go to their recipient\"]"));
+    true
 }
 
