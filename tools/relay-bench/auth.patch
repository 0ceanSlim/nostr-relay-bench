+/// A connection for one mailbox, AUTHed as its recipient when the relay asks.
+async fn open_mailbox(sh: &Shared, mb: &Mailboxes, id: usize, pk: &[u8; 32]) -> Result<crate::net::Conn, String> {
+    let mut c = connect(&sh.target, source_ip(id, sh.src_ips)).await.map_err(|e| format!("connect failed: {e}"))?;
+    match mb.keys.get(pk) {
+        None => sh.note(format!("{}: no key for mailbox {}, read without AUTH", sh.name, hex::encode_string(pk))),
+        Some(signer) => match authenticate(&mut c, signer, &sh.url, sh.timeout).await {
+            Ok(Auth::Accepted) => {
+                mb.accepted.fetch_add(1, Relaxed);
+            }
+            Ok(Auth::Unasked) => {
+                mb.unasked.fetch_add(1, Relaxed);
+            }
+            Err(e) => {
+                mb.refused.fetch_add(1, Relaxed);
+                sh.note(format!("{}: {e}", sh.name));
+            }
+        },
+    }
+    Ok(c)
+}
+
+/// Opens a connection for every mailbox the pool reads, before the clock starts, one
+/// task per worker over that worker's share. Mailboxes already open are kept.
+async fn open_mailboxes(sh: &Arc<Shared>) {
+    let Some(mb) = &sh.mailboxes else { return };
+    let mut seen = HashSet::new();
+    let open: HashSet<[u8; 32]> = mb.conns.lock().unwrap().keys().copied().collect();
+    let want: Vec<[u8; 32]> = sh.pool.ops.iter().filter_map(|op| op.mailbox).filter(|pk| !open.contains(pk) && seen.insert(*pk)).collect();
+    let tasks: Vec<_> = (0..sh.workers)
+        .map(|w| {
+            let (sh, mb) = (sh.clone(), mb.clone());
+            let mine: Vec<[u8; 32]> = want.iter().skip(w).step_by(sh.workers).copied().collect();
+            tokio::spawn(async move {
+                for pk in mine {
+                    match open_mailbox(&sh, &mb, w, &pk).await {
+                        Ok(c) => {
+                            mb.conns.lock().unwrap().insert(pk, c);
+                        }
+                        Err(e) => sh.note(format!("{}: {e}", sh.name)),
+                    }
+                }
+            })
+        })
+        .collect();
+    for t in tasks {
+        t.await.expect("mailbox opener panicked");
+    }
+}
