+enum Auth {
+    Accepted,
+    /// The relay never sent a challenge.
+    Unasked,
+}
+
+/// NIP-42 on a fresh connection, as `signer`. A probe REQ for the signer's own mailbox
+/// draws the challenge from a relay that sends it only when a read needs it; one sent on
+/// connect is already queued ahead of the probe's answer.
+async fn authenticate(c: &mut crate::net::Conn, signer: &Signer, url: &str, wait: Duration) -> Result<Auth, String> {
+    let probe = format!("[\"REQ\",\"auth-probe\",{{\"kinds\":[{}],\"#p\":[\"{}\"],\"limit\":1}}]", crate::data::GIFT_WRAP, signer.pk_hex());
+    c.send_text(&probe).await.map_err(|e| e.to_string())?;
+    let mut challenge = None;
+    let mut closed = false;
+    loop {
+        // A challenge may trail the refusal that prompted it: wait a moment for it.
+        let left = if closed { Duration::from_millis(500) } else { wait };
+        let text = match recv_text(c, left).await {
+            Ok(t) => t,
+            Err(RecvError::Timeout) if closed => break,
+            Err(e) => return Err(format!("AUTH probe: {e}")),
+        };
+        match parse_relay_msg(&text) {
+            RelayMsg::Auth(ch) => {
+                challenge = Some(ch);
+                if closed {
+                    break;
+                }
+            }
+            RelayMsg::Eose { sub: "auth-probe" } => {
+                c.send_text("[\"CLOSE\",\"auth-probe\"]").await.map_err(|e| e.to_string())?;
+                break;
+            }
+            RelayMsg::Closed { sub: "auth-probe", .. } if challenge.is_some() => break,
+            RelayMsg::Closed { sub: "auth-probe", .. } => closed = true,
+            _ => {}
+        }
+    }
+    let Some(challenge) = challenge else { return Ok(Auth::Unasked) };
+    let mut tags = String::from("[");
+    push_tag(&mut tags, &["relay", url]);
+    push_tag(&mut tags, &["challenge", &challenge]);
+    tags.push(']');
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_secs());
+    let ev = signer.sign(now, 22242, &tags, "");
+    c.send_text(&format!("[\"AUTH\",{}]", ev.json)).await.map_err(|e| e.to_string())?;
+    loop {
+        let text = recv_text(c, wait).await.map_err(|e| format!("AUTH: {e}"))?;
+        if let RelayMsg::Ok { id, accepted, msg } = parse_relay_msg(&text) {
+            if id == ev.id {
+                return if accepted { Ok(Auth::Accepted) } else { Err(format!("AUTH refused: {msg}")) };
+            }
+        }
+    }
+}
